# LLM Configuration
DEFAULT_LLM=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
USE_RERANKING=true
